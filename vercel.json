{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cleanup-expired.js": {
      "experimentalTriggers": [
        {
          "type": "schedule/v1beta"
        }
      ]
    }
  },
  "schedules": {
    "cleanup-expired-quizzes": {
      "schedule": "*/30 * * * *",
      "function": "api/cleanup-expired"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
